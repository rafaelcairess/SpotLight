<?xml version="1.0" encoding="utf-8"?>
<!-- Define de onde o .NET pode baixar pacotes externos. -->
<configuration>
  <packageSources>
    <!-- Remove fontes herdadas para a instalação ser reproduzível. -->
    <clear />
    <!-- nuget.org é o repositório público oficial usado pelos pacotes deste projeto. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
